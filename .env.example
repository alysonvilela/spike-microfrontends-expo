# ============================================================================
# Environment variables — copy to .env.local and fill in
# ============================================================================

# ---- Domain (local) ----
# The registrable domain used by local dev. Must match the Caddyfile.
HOST=alysonvilela.local

# ---- App ports (local, direct access) ----
# When dev servers run directly (not behind Caddy), set these to the
# actual ports each app listens on.
BACKEND_PORT=3001
APP_CLUBE_PORT=3000

# ---- Domain (production) ----
# Production uses a real public domain with Let's Encrypt certs via Caddy.
PRODUCTION_HOST=alysonvilela.com

# ---- Caddy TLS ----
# Set to non-privileged ports if you cannot bind 80/443.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
