# Local development Caddyfile
# ============================
#
# Provides TLS-terminated reverse-proxy for every micro-frontend and the
# backend, so Safari and iOS WebViews get real HTTPS — not the localhost
# Secure-cookie exception that only Chrome/Firefox grant.
#
# Usage
# -----
#   caddy run                   # uses port 80/443 (needs CAP_NET_BIND_SERVICE
#                               # on Linux, or run with sudo)
#
#   CADDY_HTTP_PORT=8080 \
#   CADDY_HTTPS_PORT=8443 \
#   caddy run                   # non-privileged ports
#
# First run
# ---------
# Caddy auto-generates a locally-trusted CA on first use.  Run
#
#   caddy trust
#
# to install its root certificate into the system trust store (one-time).
# After that, every `*.alysonvilela.local` URL works in all browsers,
# including Safari, with a valid HTTPS certificate.
#
# See scripts/setup-local-tls.sh for an automated setup.

{
  # Use the internal (locally-trusted) CA for all certificates.
  # This avoids rate-limited Let's Encrypt calls during local dev.
  local_certs

  # Optional: override default ports via env vars
  http_port {$CADDY_HTTP_PORT:80}
  https_port {$CADDY_HTTPS_PORT:443}
}

# ---- Wildcard handler for *.alysonvilela.local ----
# All subdomains share one wildcard cert generated by Caddy's internal CA.

*.alysonvilela.local {
  tls internal

  # -- Backend (Better Auth) --
  #   auth.alysonvilela.local → localhost:3001
  @auth host auth.alysonvilela.local
  handle @auth {
    reverse_proxy localhost:3001
  }

  # -- app-clube (Next.js) --
  #   clube.alysonvilela.local → localhost:3000
  @clube host clube.alysonvilela.local
  handle @clube {
    reverse_proxy localhost:3000
  }

  # -- Catch-all --
  # Any subdomain not matched above gets a development landing page.
  handle {
    respond "alysonvilela.local dev — unknown subdomain" 404
  }
}
